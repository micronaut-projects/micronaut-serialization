@@ -61,6 +61,16 @@ public class UsersJsonProvider implements JsonProvider<Users> {
 
     private final com.bigcloud.djomo.Json djomo = new com.bigcloud.djomo.Json();
 
+    /*
+     * Micronaut Serde (generated serializers for @Serdeable Users; JSON via the Jackson 3 backed mapper)
+     */
+    private final io.micronaut.context.ApplicationContext micronautContext = io.micronaut.context.ApplicationContext.run(java.util.Map.of(
+            "micronaut.serde.serialization.inclusion", "ALWAYS"));
+    private final MicronautMapper<Users> micronaut = new MicronautMapper<>(
+            micronautContext.getBean(io.micronaut.serde.jackson.JacksonJsonMapper.class)
+                    .createSpecific(io.micronaut.core.type.Argument.of(Users.class)),
+            io.micronaut.core.type.Argument.of(Users.class));
+
     // json-io WriteOptions is immutable+thread-safe once built; cache one instance per provider
     // to match how every other library here caches its mapper/parser/serializer. Read-side uses
     // JsonIo.toMaps()/toJava() which manage their own option caches internally.
@@ -200,6 +210,11 @@ public class UsersJsonProvider implements JsonProvider<Users> {
         return djomo;
     }
 
+    @Override
+    public MicronautMapper<Users> micronaut() {
+        return micronaut;
+    }
+
     @Override
     public WriteOptions jsonioWriteOptions() {
         return jsonioWriteOptions;
