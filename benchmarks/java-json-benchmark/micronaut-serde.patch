diff --git a/src/main/java/com/github/fabienrenaud/jjb/provider/MicronautMapper.java b/src/main/java/com/github/fabienrenaud/jjb/provider/MicronautMapper.java
new file mode 100644
index 0000000..f0df5f3
--- /dev/null
+++ b/src/main/java/com/github/fabienrenaud/jjb/provider/MicronautMapper.java
@@ -0,0 +1,29 @@
+package com.github.fabienrenaud.jjb.provider;
+
+import io.micronaut.core.type.Argument;
+import io.micronaut.json.JsonMapper;
+
+import java.io.IOException;
+
+/**
+ * A Micronaut Serde {@link JsonMapper} specialised to one {@link Argument}, so the benchmark loops call it with the
+ * same shape as the other libraries (pojo in, bytes out and back).
+ */
+public final class MicronautMapper<T> {
+
+    private final JsonMapper mapper;
+    private final Argument<T> type;
+
+    public MicronautMapper(JsonMapper mapper, Argument<T> type) {
+        this.mapper = mapper;
+        this.type = type;
+    }
+
+    public byte[] write(T pojo) throws IOException {
+        return mapper.writeValueAsBytes(type, pojo);
+    }
+
+    public T read(byte[] json) throws IOException {
+        return mapper.readValue(json, type);
+    }
+}
